{{!
    @template qtype_aitext/examplepreview

    Preview of one example question: how the student sees it, and how it is set up for the AI.

    Context variables required for this template:
    * path, subject, subjectlabel, name, description - example details
    * fromcategory - whether the example is from the site's example category
    * tags - list of {facet, label}
    * questiontext - HTML of the question text
    * responselines, defaultgrade, minwordlimit, maxwordlimit - response settings
    * aiprompt, markscheme - plain text
    * samples - list of {response}, hassamples
    * canprefill - whether the example can prefill a new question (images are import only)
    * generalfeedback, graderinfo - HTML, may be empty

    Example context (json):
    {
        "path": "english/future-tense",
        "fromcategory": false,
        "subject": "english",
        "subjectlabel": "English",
        "name": "The future tense",
        "description": "One-sentence response checking use of a future form.",
        "tags": [{"facet": "level", "label": "Esl"}],
        "questiontext": "<p>Write a sentence about next weekend.</p>",
        "responselines": 5,
        "defaultgrade": "3",
        "minwordlimit": "",
        "maxwordlimit": "",
        "aiprompt": "Check the sentence uses the future tense.",
        "markscheme": "Award marks out of 3.",
        "samples": [{"response": "Next weekend I will visit my grandparents."}],
        "hassamples": true,
        "canprefill": true,
        "generalfeedback": "",
        "graderinfo": ""
    }
}}
<article class="qtype_aitext_examples-preview" data-path="{{path}}" data-subject="{{subject}}" data-subjectlabel="{{subjectlabel}}"
        data-canprefill="{{#canprefill}}1{{/canprefill}}{{^canprefill}}0{{/canprefill}}">
    <h3 class="h4">{{name}}{{#fromcategory}}
        <span class="badge bg-info text-dark ms-1 fs-6" title="{{#str}} examplecategorybadgetitle, qtype_aitext {{/str}}">{{#str}} examplecategorybadge, qtype_aitext {{/str}}</span>{{/fromcategory}}</h3>
    {{#description}}<p>{{description}}</p>{{/description}}
    <p>
        {{#tags}}
            <span class="badge bg-secondary text-dark me-1" title="{{facet}}">{{label}}</span>
        {{/tags}}
    </p>

    {{^canprefill}}
        <p class="alert alert-info">{{#str}} examplesimportonly, qtype_aitext {{/str}}</p>
    {{/canprefill}}
    <div class="que aitext mb-3">
        <div class="content">
            <div class="formulation clearfix">
                <div class="qtext">{{{questiontext}}}</div>
                <label class="visually-hidden sr-only" for="qtype_aitext_examples-response">{{#str}} response, qtype_aitext {{/str}}</label>
                <textarea id="qtype_aitext_examples-response" class="form-control" rows="{{responselines}}" disabled></textarea>
            </div>
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">{{#str}} defaultmark, question {{/str}}</dt>
        <dd class="col-sm-9">{{defaultgrade}}</dd>
        {{#minwordlimit}}
            <dt class="col-sm-3">{{#str}} minwordlimit, qtype_aitext {{/str}}</dt>
            <dd class="col-sm-9">{{minwordlimit}}</dd>
        {{/minwordlimit}}
        {{#maxwordlimit}}
            <dt class="col-sm-3">{{#str}} maxwordlimit, qtype_aitext {{/str}}</dt>
            <dd class="col-sm-9">{{maxwordlimit}}</dd>
        {{/maxwordlimit}}
        <dt class="col-sm-3">{{#str}} aiprompt, qtype_aitext {{/str}}</dt>
        <dd class="col-sm-9 qtype_aitext_examples-text">{{aiprompt}}</dd>
        <dt class="col-sm-3">{{#str}} markscheme, qtype_aitext {{/str}}</dt>
        <dd class="col-sm-9 qtype_aitext_examples-text">{{markscheme}}</dd>
        {{#hassamples}}
            <dt class="col-sm-3">{{#str}} examplessamples, qtype_aitext {{/str}}</dt>
            <dd class="col-sm-9">
                <ul class="ps-3 mb-0">
                    {{#samples}}<li class="qtype_aitext_examples-text">{{response}}</li>{{/samples}}
                </ul>
            </dd>
        {{/hassamples}}
        {{#graderinfo}}
            <dt class="col-sm-3">{{#str}} graderinfo, qtype_aitext {{/str}}</dt>
            <dd class="col-sm-9">{{{graderinfo}}}</dd>
        {{/graderinfo}}
        {{#generalfeedback}}
            <dt class="col-sm-3">{{#str}} generalfeedback, question {{/str}}</dt>
            <dd class="col-sm-9">{{{generalfeedback}}}</dd>
        {{/generalfeedback}}
    </dl>
</article>
