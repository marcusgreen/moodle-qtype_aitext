{{!
    @template qtype_aitext/examplelibrary

    Browse the example questions by subject, preview one and import it.

    Each example is a link to the page with an example param, so the page works without
    JavaScript. With JavaScript the preview is loaded in place.

    Data attributes required for JS:
    * data-region="examplelibrary" with data-contextid
    * data-action="preview" with data-path on each example link
    * data-region="preview"

    Context variables required for this template:
    * contextid - context for loading previews
    * subjects - subjects with their examples
    * importform - HTML of the import form
    * preview - HTML of the selected example preview, or empty

    Example context (json):
    {
        "contextid": 1,
        "subjects": [
            {
                "subject": "english",
                "label": "English",
                "count": 1,
                "expanded": true,
                "examples": [
                    {"path": "english/future-tense", "name": "The future tense", "url": "#", "selected": true}
                ]
            }
        ],
        "importform": "<form></form>",
        "preview": ""
    }
}}
<div class="qtype_aitext_examples row" data-region="examplelibrary" data-contextid="{{contextid}}">
    <nav class="col-lg-4 mb-3" aria-label="{{#str}} examplesbysubject, qtype_aitext {{/str}}">
        <h3 class="h5">{{#str}} examplesbysubject, qtype_aitext {{/str}}</h3>
        {{#subjects}}
            <details class="qtype_aitext_examples-subject mb-1" data-subject="{{subject}}" {{#expanded}}open{{/expanded}}>
                <summary class="fw-bold">
                    {{label}} <span class="badge bg-secondary text-dark">{{count}}</span>
                </summary>
                <ul class="list-unstyled ms-3 mb-2">
                    {{#examples}}
                        <li>
                            <a href="{{url}}" class="qtype_aitext_examples-item d-block px-2 py-1 rounded{{#selected}} active{{/selected}}"
                               data-action="preview" data-path="{{path}}" {{#selected}}aria-current="true"{{/selected}}>{{name}}</a>
                        </li>
                    {{/examples}}
                </ul>
            </details>
        {{/subjects}}
    </nav>
    <div class="col-lg-8">
        <div class="qtype_aitext_examples-import p-3 mb-3 border rounded">
            {{{importform}}}
        </div>
        <div data-region="preview" aria-live="polite">
            {{#preview}}{{{preview}}}{{/preview}}
            {{^preview}}
                <p class="text-muted">{{#str}} examplesnopreview, qtype_aitext {{/str}}</p>
            {{/preview}}
        </div>
    </div>
</div>
